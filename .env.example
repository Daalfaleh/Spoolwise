# Public Supabase project settings. These values are designed to be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The server reads the same values from Cloudflare Worker bindings in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only transactional email settings. Add these with `wrangler secret put` in production.
RESEND_API_KEY=re_your_server_side_api_key
EMAIL_FROM=Spoolwise <hello@mail.your-domain.com>
EMAIL_REPLY_TO=hello@your-domain.com

# Server-only Moyasar subscription settings. Store every value except the publishable key
# with `wrangler secret put`; never commit live merchant credentials.
MOYASAR_PUBLISHABLE_KEY=pk_test_your_publishable_key
MOYASAR_SECRET_KEY=sk_test_your_secret_key
MOYASAR_WEBHOOK_SECRET=your_long_random_webhook_secret
MOYASAR_SAMSUNG_PAY_SERVICE_ID=your_approved_samsung_service_id
PREMIUM_MONTHLY_PRICE_HALALAS=your_approved_price_in_halalas
# Generate 32 random bytes and encode them as base64. Rotating this requires a token migration.
SUBSCRIPTION_TOKEN_KEY=base64_encoded_32_byte_key
